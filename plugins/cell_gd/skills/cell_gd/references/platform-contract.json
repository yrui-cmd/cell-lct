{
  "skillId": "cell_gd",
  "outputBasenamePattern": "shibielujingN",
  "apiBaseUrl": "https://xiaomiao-ai.com",
  "geometryCacheSchema": 3,
  "textManifestSchema": "1.0",
  "ordinaryBatchMin": 20,
  "ordinaryBatchMax": 50,
  "complexPointThreshold": 320,
  "maxBatchPoints": 2200,
  "slideMarginPoints": 18,
  "windowsStepDelayMs": 8,
  "visibilityRule": "remove-exact-duplicates-only",
  "drawingOrder": "literal-source-paint-order-back-to-front",
  "preexistingObjects": "preserve",
  "credentials": {
    "windows": "DPAPI:%USERPROFILE%/.codex/secrets/xiaomiao-api-key.dpapi",
    "macos": "Keychain:cell-ppt-xiaomiao"
  },
  "backends": {
    "windows": "live-powerpoint-com",
    "macos": "editable-ooxml-saved-pptx",
    "wps": "experimental"
  },
  "powerPointCompatibility": {
    "windows": ["2016", "2019", "2021", "LTSC 2021", "LTSC 2024", "Microsoft 365 desktop"],
    "macos": ["2019", "2021", "2024", "Microsoft 365 desktop"],
    "notYearLocked": true
  },
  "installation": {
    "autoDetectRuntime": true,
    "autoInstallDependencies": true,
    "autoSelectBackend": true,
    "chatApiKeyAllowed": true,
    "credentialTransport": "stdin-only",
    "credentialVerification": "automatic-zero-credit"
  }
}
